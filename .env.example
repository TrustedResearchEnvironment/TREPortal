# Copy to .env and fill in. .env is git-ignored.

# The Azure Container App injects SQLDB_CONNECTION_STRING. For local compose runs, export it in your shell instead:
# export SQLDB_CONNECTION_STRING="mssql+pyodbc://<user>:<password>@<server>.database.windows.net/<database>?driver=ODBC+Driver+17+for+SQL+Server&Encrypt=yes&TrustServerCertificate=no"


# Set to prod in deployed environments. This turns off /docs, /redoc and /openapi.json.
ENVIRONMENT=dev

# API_KEY is injected by nginx into every /api/ request.
# API_UPN is a dev-only fallback user. The API ignores it when ENVIRONMENT=prod.
API_KEY=
API_UPN=

# Microsoft Entra ID sign-in. Leave both blank locally to skip sign-in; they are required when ENVIRONMENT=prod.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
# Origin allowed to embed the app in an iframe, for example https://<loome-host>. Defaults to *.
# FRAME_ANCESTORS=

# Secret used to sign dataset column metadata (HMAC)
HMAC_KEY=

# Application timezone, for example UTC or Europe/London. Defaults to UTC.
APP_TIMEZONE=UTC

# Portal settings read by PortalLib/CatalogueLib.py
TOKEN_URL=
API_BASE_URL=
CLIENT_ID=
CLIENT_SECRET=
SSL_VERIFY=false
CUSTOM_APP_NAME="TRE Research Assets"
# Optional: client certificate path, if the Portal API requires one
# CLIENT_CERT_PATH=

# Integrate settings read by PortalLib/IntegrateLib.py
LOOME_INTEGRATE_TOKEN_URL=
LOOME_INTEGRATE_API_BASE_URL=
LOOME_INTEGRATE_CLIENT_ID=
LOOME_INTEGRATE_CLIENT_SECRET=
LOOME_INTEGRATE_DATA_EXPORT_PROJECT_NAME=
LOOME_INTEGRATE_DATA_IMPORT_PROJECT_NAME=
LOOME_INTEGRATE_EXPORT_TASK_NAME=
LOOME_INTEGRATE_IMPORT_TASK_NAME=
LOOME_INTEGRATE_PREP_REPOS_TASK_NAME=
LOOME_INTEGRATE_APPROVE_IMPORT_PROJECT_NAME=
LOOME_INTEGRATE_APPROVE_IMPORT_TASK_NAME=
LOOME_INTEGRATE_APPROVE_EXPORT_PROJECT_NAME=
LOOME_INTEGRATE_APPROVE_EXPORT_TASK_NAME=
LOOME_INTEGRATE_SUBMIT_DATA_IMPORT_PROJECT_NAME=
LOOME_INTEGRATE_SUBMIT_DATA_IMPORT_TASK_NAME=

# Assist settings read by PortalLib/AssistLib.py
LOOME_ASSIST_TOKEN_URL=
LOOME_ASSIST_API_BASE_URL=
LOOME_ASSIST_CLIENT_ID=
LOOME_ASSIST_CLIENT_SECRET=
