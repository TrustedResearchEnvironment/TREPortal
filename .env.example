# Copy to .env and fill in. .env is git-ignored.

# The Azure Container App injects SQLDB_CONNECTION_STRING. For local compose runs, export it in your shell instead:
# export SQLDB_CONNECTION_STRING="mssql+pyodbc://<user>:<password>@<server>.database.windows.net/<database>?driver=ODBC+Driver+17+for+SQL+Server&Encrypt=yes&TrustServerCertificate=no"


# Injected by nginx into every /api/ request
API_KEY=
API_UPN=

# Portal / Loome settings read by the API
TOKEN_URL=
API_BASE_URL=
CLIENT_ID=
CLIENT_SECRET=
SSL_VERIFY=false
CUSTOM_APP_NAME="TRE Research Assets"
